    UC4 -.->|"<<extend>>"| UC4_4
    UC4 -.->|"<<extend>>"| UC4_5

    UC5 -.->|"<<include>>"| UC5_1
    UC5 -.->|"<<include>>"| UC5_2

    UC8 -.->|"<<include>>"| UC8_1
